{
  "name": "amigo-secreto",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "nodemon app",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:up:ephemeral": "docker compose -f docker-compose.ephemeral.yml up -d mongodb",
    "db:down:ephemeral": "docker compose -f docker-compose.ephemeral.yml down",
    "db:reset": "docker compose exec -T mongodb mongosh secretSanta --quiet --eval \"db.dropDatabase(); print('banco zerado')\"",
    "db:destroy": "docker compose down -v",
    "web:up": "docker compose up -d --build web",
    "web:down": "docker compose stop web"
  },
  "keywords": [
    "node"
  ],
  "author": "Wagner Souza, Deyvison Ramos, Davi Nunes e Raphael Machado",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^7.0.5",
    "nodemailer": "^6.9.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^2.0.21",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/web/"
    ]
  }
}